      "sha256": "789315e62bdc73ee5c002416e681f96b48efdf87e95d6ce118823dea0c4f7f57",
      "kind": "dialogue",
      "cue": "opening",
      "speaker": "四时旁白",
      "text": "先把小黑的围巾拼回来，再看看落在伞边的小雪花。",
      "synthesis": {
        "provider": "Microsoft Edge online TTS via edge-tts",
        "voice": "zh-CN-XiaoxiaoNeural",
        "rate": "-8%",
        "pitch": "+0Hz"
      }
    },
