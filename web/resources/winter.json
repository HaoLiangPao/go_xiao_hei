      "kind": "dialogue",
      "cue": "complete",
      "speaker": "四时旁白",
      "text": "水汽、落叶和茶盏都回来了，初冬也有了暖暖的歇脚处。",
      "synthesis": {
        "provider": "Microsoft Edge online TTS via edge-tts",
        "voice": "zh-CN-XiaoxiaoNeural",
        "rate": "-8%",
        "pitch": "+0Hz"
      }
    },
