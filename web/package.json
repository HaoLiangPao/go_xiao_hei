{
  "name": "xiaohei-shiguang-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test:journey-browser": "node tests/journey-browser.cjs",
    "test:material-browser": "node tests/material-browser.cjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/geometry.test.js tests/gameplay.test.js tests/journey.test.js tests/dialogue.test.js tests/resources.test.js tests/season-content.test.js tests/character-model.test.js tests/collections.test.js",
    "audio:generate": "node scripts/generate-dialogue.mjs",
    "test:model": "node ../tests/scene-model.test.cjs",
    "test:dom": "node ../tests/color-interaction.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:voice-browser": "node tests/dialogue-browser.cjs",
    "predev": "node scripts/prepare-public.mjs && node scripts/model-resources.mjs",
    "prebuild": "node scripts/prepare-public.mjs && node scripts/model-resources.mjs",
    "resources:publish": "node scripts/publish-resources.mjs",
    "resources:check": "node scripts/runtime-resources.mjs",
    "test:spring-browser": "node tests/spring-browser.cjs",
    "test:season-browser": "node tests/season-browser.cjs",
    "test:characters-browser": "node tests/characters-browser.cjs",
    "characters:check": "node scripts/character-resources.mjs",
    "models:build": "node scripts/build-model-lab.mjs",
    "test:models": "node --test tests/models.test.js",
    "test:models-browser": "node tests/models-browser.cjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "playwright": "1.61.1",
    "three": "0.181.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
